{
  "schemaVersion": 1,
  "id": "mattress-vitals",
  "name": "床垫生命体征",
  "version": "2.0.0",
  "description": "复用 onbed_filter 的呼吸率、生命体征与独立容错重心。respirationRate 是次/分的单值，可按时间入队画呼吸率趋势；-1 为未稳定，88 为检测中，不能作为测量值。当前接口不提供呼吸波形，不输出 respirationSignal，不以压力趋势替代。",
  "apiVersion": 2,
  "language": "python",
  "entry": "algorithm.py",
  "runtime": {
    "python": "3.11",
    "profile": "bundled-v1"
  },
  "input": {
    "mode": "single-sensor",
    "sync": {
      "strategy": "latest",
      "maxSkewMs": 50,
      "maxAgeMs": 1000
    }
  },
  "parameters": { "sampleRateHz": 50.0 },
  "output": {
    "metrics": [
      "respirationRate",
      "minuteRespirationRate",
      "heartRate",
      "stateInBed",
      "sosFlag",
      "alarmState",
      "pressureCoefficient",
      "copX",
      "copY",
      "copDistance",
      "strokeRisk",
      "sleepState",
      "bodyMovement",
      "onbedFilterHealthy"
    ],
    "metricDefinitions": [
      { "id": "respirationRate", "label": "呼吸率", "unit": "次/分", "decimals": 1, "panel": "pressure" },
      { "id": "minuteRespirationRate", "label": "分钟呼吸率", "unit": "次/分", "decimals": 1, "panel": "none" },
      { "id": "heartRate", "label": "心率", "unit": "bpm", "decimals": 1, "panel": "pressure" },
      { "id": "stateInBed", "label": "在床状态", "unit": "", "decimals": 0, "panel": "none" },
      { "id": "sosFlag", "label": "SOS", "unit": "", "decimals": 0, "panel": "none" },
      { "id": "alarmState", "label": "综合告警", "unit": "", "decimals": 0, "panel": "none" },
      { "id": "pressureCoefficient", "label": "压力系数", "unit": "", "decimals": 3, "panel": "none" },
      { "id": "copX", "label": "重心 X", "unit": "点", "decimals": 2, "panel": "none" },
      { "id": "copY", "label": "重心 Y", "unit": "点", "decimals": 2, "panel": "none" },
      { "id": "copDistance", "label": "重心偏移", "unit": "点", "decimals": 2, "panel": "none" },
      { "id": "strokeRisk", "label": "中风风险", "unit": "", "decimals": 0, "panel": "none" },
      { "id": "sleepState", "label": "睡眠状态", "unit": "", "decimals": 0, "panel": "none" },
      { "id": "bodyMovement", "label": "体动", "unit": "", "decimals": 2, "panel": "none" },
      { "id": "onbedFilterHealthy", "label": "生命体征算法状态", "unit": "", "decimals": 0, "panel": "none" }
    ]
  },
  "catalog": {
    "category": "health",
    "tags": ["32x32", "呼吸", "心率", "在离床"],
    "compatibility": {
      "matrixTotals": [1024],
      "recommendedMatrices": [{ "rows": 32, "cols": 32 }]
    },
    "sampleRateHz": 50,
    "singleton": true,
    "attachable": true
  }
}
