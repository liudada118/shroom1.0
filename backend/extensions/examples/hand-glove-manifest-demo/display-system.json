{
  "schemaVersion": 1,
  "id": "hand-glove-manifest-demo",
  "name": "Hand Glove Manifest Demo",
  "version": "0.1.0",
  "description": "Template for migrating the existing hand glove dual-channel runtime into a manifest driven display system.",
  "sensor": {
    "type": "hand0205",
    "matrix": {
      "rows": 16,
      "cols": 16
    },
    "ports": ["sit", "back"]
  },
  "files": {
    "lineOrder": "line-order.json",
    "pointOrder": "point-order.json"
  },
  "algorithm": {
    "type": "json",
    "dataFile": "algorithm-data.json"
  },
  "display": {
    "views": ["heatmap", "model"],
    "defaultView": "model"
  },
  "metadata": {
    "migrationTemplate": true,
    "runtimeMode": "template",
    "sourceRuntime": "backend/extensions/built-in-sensors/handPacketRuntime.js"
  }
}
