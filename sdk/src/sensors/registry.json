{
  "_meta": {
    "purpose": "传感器技术注册表 —— 唯一真相。协议、矩阵、通道、波特率都以本文件为准。",
    "consumers": [
      "sdk/src/profiles.js（协议画像，最终应由本表生成）",
      "listPorts({ probe: true }) 的自动识别",
      "客户侧的 AI / 代码生成（本表是机器可读的，不要手抄成 markdown 表格）"
    ],
    "invariants": [
      "licenseSensorGroups.json 里每个可售 value 都必须在 sensors 里有条目 —— 否则客户能买到 SDK 解不出来的传感器",
      "verified=true 的条目必须有完整 protocol.baudRate / valueType / pressureLength 和 matrix",
      "由 test/sensorRegistry.test.js 强制，不要手工维护一致性"
    ],
    "verifiedMeaning": "true = sdk/src/profiles.js 里有可用画像，实机验证过。false = 可售但 SDK 尚无画像，unknown 字段列出缺什么。",
    "delimiterFormat": "hex 字符串，无分隔符。standard = aa550399"
  },

  "delimiters": {
    "standard": "aa550399",
    "smallBed12BTail": "aa0055000300 9900"
  },

